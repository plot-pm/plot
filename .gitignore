# OS
.DS_Store
Thumbs.db

# Editors
*.swp
*.swo
*~
.idea/
.vscode/

# Dependencies
node_modules/

# Agent tooling — per-developer session state and caches, not project content.
# (oh-my-claudecode writes session logs, a HUD cache, and project memory here;
# these mutate on every run and are personal to whoever is working.)
.omc/

# Machine-local Plot state. The rest of `.plot` is project content (briefs,
# templates, the review hold) and stays committed; this holds caches describing
# THIS machine's refs and worktrees — the board's last-good pulse among them.
# A checked-in pulse would be one clone telling another what its branches are
# doing.
.plot/state/
