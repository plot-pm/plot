# plot-fleetd, kept alive by systemd — Linux.
#
# Replace the three placeholders before installing:
#   __REPO_ROOT__   absolute path to the repository this daemon supervises
#   __NODE__        absolute path to node 24 (`which node` under `nvm use`)
#   __FLEETD__      absolute path to plot-fleetd.mjs
#
# Install: skills/plot/units/README.md

[Unit]
Description=plot-fleetd — supervises the agents registered in __REPO_ROOT__
Documentation=https://github.com/plot-pm/plot/blob/main/skills/plot/units/README.md

# The daemon reads git refs and asks the git host, so it starts after the
# network. It does not REQUIRE the network: an unreachable host reads
# `unreachable` and a tick decides to leave every agent alone, which is the
# correct answer rather than a reason not to run.
After=network-online.target

# A CRASH LOOP IS THROTTLED AND NEVER GIVEN UP ON. `StartLimitIntervalSec=0`
# turns off systemd's "fail permanently after N restarts" rule, because a
# permanently stopped supervisor is the failure this unit exists to prevent —
# the machine that was unreachable for an hour is exactly when the agents need
# supervising.
StartLimitIntervalSec=0

[Service]
Type=simple

# A USER SERVICE, NOT A SYSTEM ONE. The daemon reaps worktrees and reads
# `~/.claude` transcripts, both of which belong to the person who dispatched the
# agents. Running it as root would give it write access to every desk on the
# machine to save typing `--user`.

WorkingDirectory=__REPO_ROOT__
Environment=PLOT_REPO_ROOT=__REPO_ROOT__

# git, gh, node and the agent harness (claude, or the name in PLOT_HARNESS)
# must be findable: systemd gives a unit a minimal PATH, and it holds no
# directory the harness installs to. The first entry is the directory
# `plot-fleetctl.sh --start` resolved the harness in with `command -v`, so a
# worker runs the binary the operator's shell runs. It comes first for EVERY
# binary in that directory, not only the harness; on a typical install that is
# ~/.local/bin.
Environment=PATH=__HARNESS_DIR__:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin

# `--start-agents` IS WHAT MAKES THIS A SUPERVISOR. The flag defaults off so that
# `/plot-fleet --once` can run against a live estate for free — a tick without it
# decides every hand-over and performs none. The long-running unit is the one
# place where that is nobody's intent. Measured 2026-09-07: three consecutive
# ticks reported `handed=2` while both free agents' manifests read `branch: ""`
# and had been quiet 3,067 seconds.
#
# `--sweep-temp` runs `plot-reap.sh --sweep-temp --yes` at most once an hour:
# nothing else schedules the backstop for temp paths a SIGKILL left behind.
ExecStart=__NODE__ __FLEETD__ --start-agents --sweep-temp

# THE UNIT STOPS ONLY ITS DAEMON. An agent is not part of the daemon's
# lifecycle: the supervisor starts agents with `--start-agents` and they outlive
# any tick, so systemd's default `KillMode=control-group` — which signals every
# process in the cgroup on stop, restart or crash — ends work that is nobody's
# intent to end. systemd.kill(5) does not recommend `process` because processes
# then outlive the unit; here that is the point.
#
# THE AGENTS STAY IN THE UNIT'S CGROUP after a restart, so
# `systemctl --user status plot-fleetd` lists them under the unit. They are
# the previous daemon's children and the new daemon finds them through the
# registry and their desks, as a tick does today.
#
# STOPPING AN AGENT IS `/plot-fleet --stop`, not a unit stop. It calls
# `plot-dispatch.sh --stop` once per dispatched agent and unloads the supervisor
# last; with this directive its *kept* report is true on Linux rather than a
# sentence about agents the next command ends.
KillMode=process

# RESTART ALWAYS, and the reason is the same one the plist gives: every
# recoverable failure is now a tick that reports and continues, so a process
# that exited is a process that is gone and restarting it is always right.
Restart=always

# THE RESTART DELAY IS THE TICK INTERVAL. A daemon that cannot start must not
# spend a core trying; a daemon whose tick failed has already waited an interval
# inside its own loop.
RestartSec=60

# Two streams, two identifiers. The tick lines go to stdout and an INCOMPLETE
# tick goes to stderr; `journalctl --user -u plot-fleetd -p err` shows only
# the ticks that could not be taken.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plot-fleetd

# BACKGROUND PRIORITY. The daemon is idle 94% of a 60 s interval and shares a
# machine with the workers it supervises; it must never be what makes a worker
# slow.
#
# THESE TWO DIRECTIVES ARE PRIORITY ALONE AND EVICT NOTHING, which is why this
# file is unchanged where the plist is not. launchd's `ProcessType: Background`
# bought priority and eviction eligibility together, and it evicted the daemon
# six times in one session under load on 2026-09-07; the plist now splits the
# two. systemd has nothing to split.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
