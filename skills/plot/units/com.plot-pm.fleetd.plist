<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  plot-fleetd, kept alive by launchd — macOS.

  Replace the four placeholders before installing:
    __LABEL__       the launchd label (`plot-fleetctl.sh` fills PLOT_FLEET_LABEL,
                    default com.plot-pm.fleetd)
    __REPO_ROOT__   absolute path to the repository this daemon supervises
    __NODE__        absolute path to node 24 (`which node` under `nvm use`)
    __FLEETD__      absolute path to plot-fleetd.mjs

  Install: skills/plot/units/README.md
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <!-- ONE DAEMON PER REPOSITORY. The default label carries no repository name,
       so a second checkout sets PLOT_FLEET_LABEL before `plot-fleetctl.sh
       --start`, which fills it here and names the file after it — see the
       README. launchd keys a job by this Label, not by the filename: two files
       sharing one Label are ONE job, and the second bootstrap fails. -->

  <!-- `--start-agents` IS WHAT MAKES THIS A SUPERVISOR. The flag defaults off so
       that `/plot-fleet --once` can run against a live estate for free — a tick
       without it decides every hand-over and performs none. The long-running
       unit is the one place where that is nobody's intent. Measured 2026-09-07:
       three consecutive ticks reported `handed=2` while both free agents'
       manifests read `branch: ""` and had been quiet 3,067 seconds.

       `--sweep-temp` runs `plot-reap.sh --sweep-temp --yes` at most once an
       hour: nothing else schedules the backstop for temp paths a SIGKILL left
       behind. -->
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__FLEETD__</string>
    <string>--start-agents</string>
    <string>--sweep-temp</string>
  </array>

  <!-- THE DAEMON READS THE REPOSITORY IT IS STARTED IN. `registryd-main.ts`
       takes `PLOT_REPO_ROOT` and falls back to `process.cwd()`; both are set
       here so neither the fallback nor a launchd working-directory default
       decides which estate is supervised. -->
  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PLOT_REPO_ROOT</key>
    <string>__REPO_ROOT__</string>
    <!-- git, gh, node and the agent harness (claude, or the name in
         PLOT_HARNESS) must be findable: launchd gives a job a minimal PATH and
         none of the four is on it. The first entry is the directory of the
         pinned node in ProgramArguments, so every child the daemon starts
         (the worker loop, pnpm, the test runner) runs the same node major as
         the daemon. The second is the directory the fleet start resolved the
         harness in with `command -v`, so a worker runs the binary the
         operator's shell runs. Each comes first for EVERY binary in its
         directory; on a typical install the harness directory is
         ~/.local/bin. Add homebrew's prefix for your arch. -->
    <key>PATH</key>
    <string>__NODE_DIR__:__HARNESS_DIR__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <!-- KEEPALIVE IS THE WHOLE POINT, and it is unconditional. The daemon exits
       only when killed or when the machine stops it; every recoverable failure
       is now a tick that reports and continues, so an exit means the process
       itself is gone and restarting it is always right. -->
  <key>KeepAlive</key>
  <true/>

  <!-- A CRASH LOOP IS THROTTLED, not fought. launchd's floor is 10 s; this
       raises it to the tick interval, so a daemon that cannot start does not
       spend a core on the attempt. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <!-- Two streams, two files. The tick lines go to stdout and an INCOMPLETE
       tick goes to stderr, so `tail -f` on the error log shows exactly the
       ticks that could not be taken. -->
  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/.plot/logs/fleetd.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/.plot/logs/fleetd.err</string>

  <!-- PRIORITY AND EVICTION ELIGIBILITY ARE TWO THINGS. The daemon is idle 94%
       of a 60 s interval and shares a machine with the workers it supervises,
       so it must not slow a worker. `Nice` carries that politeness.

       `ProcessType` Standard with `Nice` 10 keeps the daemon off the background
       band and out of the Background eviction. Measured 2026-10-11 at load 10
       on 16 cores, one scan took 33 s at normal priority, 34 s under `nice`
       10, and 94 s in the background band, which is over the fleet's 90 s scan
       budget.

       `Adaptive` acts as Background for this daemon: launchd promotes an
       Adaptive job only while it serves XPC traffic, and plot-fleetd serves
       none. The daemon and its scan child then ran at priority 4 on the
       efficiency cores with throttled I/O, and every scan timed out.

       `Background` makes the job evictable. Measured 2026-09-07, launchd
       removed the job six times in one session, with `runs = 1`, no exit code,
       an empty error log and no launchd log line each time.

       The systemd unit needs no such change: `Nice=10` and
       `IOSchedulingClass=idle` set priority and evict nothing. -->
  <key>ProcessType</key>
  <string>Standard</string>
  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
