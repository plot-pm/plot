{
  "name": "@plot-pm/domain",
  "version": "0.3.1",
  "description": "Plot's entity graph — the plans, waves and branches the fleet is about, and the rules that read them",
  "type": "module",
  "private": true,
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./adapters/host/*": "./src/adapters/host/*.ts",
    "./adapters/*": "./src/adapters/*.ts",
    "./entities/*": "./src/entities/*.ts",
    "./ports/*": "./src/ports/*.ts",
    "./rules/*": "./src/rules/*.ts",
    "./transitions/*": "./src/transitions/*.ts",
    "./workflows/*": "./src/workflows/*.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:corpus": "vitest run --config vitest.corpus.config.ts"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^5.9.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.288",
    "zod": "^4.4.0"
  },
  "engines": {
    "node": ">=24"
  }
}
